---
import BaseLayout from "../layouts/BaseLayout.astro";
import Guestbook from "../components/Guestbook.vue";
---
<BaseLayout title="Mural de Recados" description="Escolha uma nota colorida, escreva um recado e compartilhe uma mensagem carinhosa com a comunidade." heroTitle="Mural de Recados" heroSubtitle="Um espaço para compartilhar boas energias e deixar sua marca.">
  <div class="shell guestbook-shell"><Guestbook client:load /></div>
</BaseLayout>
<style>
  .guestbook-shell { padding-top: 24px; padding-bottom: 42px; }
  @media (max-width: 760px) { .guestbook-shell { padding-top: 18px; padding-bottom: 28px; } }
</style>
