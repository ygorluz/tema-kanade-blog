---
import BlogLayout from "../layouts/BlogLayout.astro";
import privacyData from "../data/privacy.json";
---
<BlogLayout title="Política de Privacidade" heroTitle="Política de Privacidade" heroSubtitle="Transparência e respeito com seus dados e sua navegação.">
  <article class="card legal-card prose">
    <h1>{privacyData.title || "Política de Privacidade"}</h1>
    <p class="last-updated">Última atualização: {privacyData.last_updated || "2026-10-21"}</p>

    {(privacyData.content || []).map((section: any) => (
      <section class="legal-section">
        <h2>{section.title}</h2>
        <p>{section.text}</p>
      </section>
    ))}
  </article>
</BlogLayout>
<style>
.legal-card { padding: 40px; max-width: 860px; margin: 0 auto; }
.legal-card h1 { font-size: 28px; margin-bottom: 8px; color: var(--text); }
.last-updated { font-size: 12px; color: var(--muted); margin-bottom: 25px; border-bottom: 1px dashed var(--line); padding-bottom: 15px; }
.legal-section { margin-bottom: 24px; }
.legal-section h2 { font-size: 18px; margin: 18px 0 8px; color: var(--text); }
.legal-section p { font-size: 14px; line-height: 1.8; color: var(--muted); }
@media (max-width: 600px) {
  .legal-card { padding: 22px; }
  .legal-card h1 { font-size: 22px; }
}
</style>
