---
import { withBase } from "../lib/urls";
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PersonalCard from "../components/home/PersonalCard.vue";
import PostCover from "../components/posts/PostCover.vue";
import { getPosts, summarize } from "../lib/posts";
import { postUrl } from "../lib/postUrl";
import { readData } from "../lib/readData";

export async function getStaticPaths() {
  const siteConfig = readData<any>("siteConfig.json", {});
  const rawPrefix = siteConfig?.postUrlPrefix;
  // Se o usuário configurou um prefixo não-vazio (ex: 'blog' ou 'posts'), os posts são gerados na subpasta
  if (rawPrefix && String(rawPrefix).trim() !== "") {
    return [];
  }

  const RESERVED = new Set([
    "admin", "api", "posts", "blog", "post", "about", "sobre", "contato", "contact",
    "privacidade", "politica-privacidade", "termos", "terms", "friends", "articles",
    "messages", "comments", "favicon.ico", "robots.txt", "sitemap.xml", "rss.xml"
  ]);

  const allPosts = await getPosts();
  return allPosts
    .filter(post => !RESERVED.has(post.id))
    .map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const allSummaries = (await getPosts()).map(summarize);
const summary = summarize(post);
const index = allSummaries.findIndex(item => item.id === post.id);
const newer = allSummaries[index - 1];
const older = allSummaries[index + 1];

const authorName = post.data.author || "Equipe Sabixão";
const coverImg = post.data.heroImage || post.data.image || post.data.coverImage || "";
---
<BaseLayout title={post.data.title} description={post.data.description} heroTitle="Aulas & Conteúdos Didáticos" heroSubtitle="Aprenda no seu ritmo com explicações claras e didáticas." article>
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
  <div class="shell article-layout">
    <article class="card article-detail">
      <a href={withBase("/posts/")} class="text-link"><span class="icon-[lucide--arrow-left]" aria-hidden="true"></span>Voltar para as aulas e artigos</a>
      <header class="article-header">
        <a class="chip" href={withBase(`/posts/?category=${encodeURIComponent(post.data.category)}`)}>{post.data.category}</a>
        <h1>{post.data.title}</h1>
        <div class="article-meta">
          <img src={withBase("/images/avatar.svg")} alt={authorName} width="25" height="25" />
          <span>{authorName}</span>
          <span>·</span>
          <time datetime={summary.date}>{summary.date.replaceAll("-", ".")}</time>
          <span>·</span>
          <span>{summary.minutes} min de leitura</span>
        </div>
        {post.data.description && <p>{post.data.description}</p>}
      </header>
      <div class="article-cover">
        <PostCover kind={post.data.cover} featured={post.data.featured} heroImage={coverImg} title={post.data.title} />
      </div>
      {headings.length > 0 && (
        <details class="mobile-toc">
          <summary>Sumário da Aula</summary>
          <ol>{headings.filter(h => h.depth <= 3).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </details>
      )}
      <div class="prose" id="article-body"><Content /></div>
      <div class="article-ending">
        <span>✿</span>
        <p>Obrigado por acompanhar esta aula no Sabixão. Bons estudos e continue praticando!</p>
      </div>
      <div class="article-tools">
        <div class="article-tags">
          {post.data.tags.map(tag => <a class="chip" href={withBase(`/posts/?tag=${encodeURIComponent(tag)}`)}># {tag}</a>)}
        </div>
        <button id="share-post" class="btn secondary"><span class="icon-[lucide--link]" aria-hidden="true"></span>Copiar link do artigo</button>
      </div>
      <p id="share-status" role="status" class="share-status"></p>
      <div class="author-note">
        <img src={withBase("/images/avatar.svg")} alt={authorName} width="44" height="44" />
        <div>
          <strong>{authorName} <span class="accent">/ Equipe Editorial</span></strong>
          <p>Publicando ideias e aprendizados semanais. Visite nosso <a href={withBase("/messages/")}>mural de recados</a> para dar um alô.</p>
        </div>
      </div>
      <nav class="adjacent-posts" aria-label="Navegação entre artigos">
        {newer ? <a href={withBase(postUrl(newer.id))}><span>← Artigo anterior</span><strong>{newer.title}</strong></a> : <div></div>}
        {older && <a href={withBase(postUrl(older.id))}><span>Próximo artigo →</span><strong>{older.title}</strong></a>}
      </nav>
    </article>
    <aside class="article-sidebar">
      <PersonalCard posts={allSummaries} />
      {headings.length > 0 && (
        <nav class="card panel toc" aria-label="Sumário"><h2 class="panel-title"><span class="icon-[lucide--list]" aria-hidden="true"></span>Sumário</h2><ol>{headings.filter(h => h.depth <= 3).map((h, i) => <li class:list={{ nested: h.depth === 3 }}><a href={`#${h.slug}`} data-heading={h.slug}><span>{String(i + 1).padStart(2, "0")}</span>{h.text}</a></li>)}</ol></nav>
      )}
    </aside>
  </div>
  <script>
    const body = document.querySelector<HTMLElement>("#article-body");
    const progress = document.querySelector<HTMLElement>("#reading-progress");
    const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-heading]")];
    const update = () => {
      if (!body || !progress) return;
      const top = body.getBoundingClientRect().top + window.scrollY;
      const distance = Math.max(1, body.offsetHeight - window.innerHeight + 130);
      progress.style.width = `${Math.min(100, Math.max(0, (window.scrollY - top + 100) / distance * 100))}%`;
      let current = "";
      for (const link of tocLinks) {
        const heading = document.getElementById(link.dataset.heading || "");
        if (heading && heading.getBoundingClientRect().top <= 150) current = link.dataset.heading || "";
      }
      tocLinks.forEach(link => {
        const selected = link.dataset.heading === current;
        link.classList.toggle("active", selected);
        selected ? link.setAttribute("aria-current", "location") : link.removeAttribute("aria-current");
      });
    };
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
    document.querySelector("#share-post")?.addEventListener("click", async () => {
      const status = document.querySelector<HTMLElement>("#share-status");
      try {
        await navigator.clipboard.writeText(window.location.href.split("#")[0]);
        if (status) status.textContent = "Link copiado para a área de transferência!";
      } catch { if (status) status.textContent = `Copie o link: ${window.location.href.split("#")[0]}`; }
      setTimeout(() => { if (status) status.textContent = ""; }, 3000);
    });
    document.querySelectorAll<HTMLPreElement>(".prose pre").forEach(pre => {
      const code = pre.querySelector("code");
      if (!code) return;
      const button = document.createElement("button");
      button.className = "copy-code"; button.textContent = "Copiar";
      button.setAttribute("aria-label", "Copiar código"); button.setAttribute("aria-live", "polite");
      button.addEventListener("click", async () => {
        try { await navigator.clipboard.writeText(code.textContent || ""); button.textContent = "Copiado!"; }
        catch { button.textContent = "Selecione o código"; }
        setTimeout(() => { button.textContent = "Copiar"; }, 2500);
      });
      pre.append(button);
    });
  </script>
</BaseLayout>
<style>
.article-layout { max-width: 1130px; display: grid; grid-template-columns: minmax(0,1fr) 235px; gap: 25px; align-items: start; padding-top: 20px; padding-bottom: 45px; }
.article-detail { padding: 35px; min-width: 0; }
.article-header { padding-top: 22px; }
.article-header h1 { font-size: 29px; line-height: 1.5; margin: 15px 0; font-weight: 600; }
.article-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; color: var(--muted); font-size: 11px; }
.article-meta img { border-radius: 50%; }
.article-header > p { color: var(--muted); font-size: 14px; line-height: 1.8; margin: 18px 0; }
.article-cover { border-radius: 12px; overflow: hidden; min-height: 220px; max-height: 380px; margin-bottom: 25px; }
.mobile-toc { display: none; background: var(--accent-soft); border-radius: 10px; padding: 12px 16px; margin: 20px 0; font-size: 13px; }
.mobile-toc summary { cursor: pointer; font-weight: 500; color: var(--accent); }
.mobile-toc ol { margin: 10px 0 0; padding-left: 20px; }
.mobile-toc li { margin: 6px 0; }
.article-ending { text-align: center; margin: 40px 0 20px; padding: 25px 0; border-top: 1px dashed var(--line); border-bottom: 1px dashed var(--line); color: var(--muted); font-size: 13px; }
.article-ending span { font-size: 24px; color: var(--accent); display: block; margin-bottom: 8px; }
.article-tools { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 15px; margin: 25px 0 10px; }
.article-tags { display: flex; flex-wrap: wrap; gap: 7px; }
.share-status { font-size: 11px; color: var(--accent); margin: 5px 0 0; min-height: 18px; }
.author-note { display: flex; align-items: center; gap: 16px; background: var(--accent-soft); padding: 18px 22px; border-radius: 14px; margin: 30px 0; }
.author-note img { border-radius: 50%; flex-shrink: 0; }
.author-note strong { font-size: 14px; display: block; margin-bottom: 4px; }
.author-note p { margin: 0; font-size: 12px; color: var(--muted); }
.author-note a { color: var(--accent); text-decoration: underline; }
.adjacent-posts { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 35px; padding-top: 25px; border-top: 1px dashed var(--line); }
.adjacent-posts a { display: flex; flex-direction: column; gap: 6px; padding: 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 12px; transition: border-color .2s; }
.adjacent-posts a:hover { border-color: var(--accent); }
.adjacent-posts a span { color: var(--muted); font-size: 11px; }
.adjacent-posts a strong { color: var(--text); font-size: 13px; line-height: 1.4; }
.article-sidebar { position: sticky; top: 90px; display: flex; flex-direction: column; gap: 20px; }
.toc ol { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; font-size: 12px; }
.toc a { display: flex; align-items: center; gap: 8px; color: var(--muted); line-height: 1.5; }
.toc a:hover, .toc a.active { color: var(--accent); font-weight: 500; }
.toc a span { font-family: "Oxanium-Medium"; font-size: 10px; color: var(--accent); opacity: .7; }
.toc li.nested { padding-left: 15px; font-size: 11px; }
.reading-progress { position: fixed; top: 70px; left: 0; height: 3px; background: var(--accent); z-index: 50; transition: width .1s ease-out; }
@media (max-width: 900px) {
  .article-layout { grid-template-columns: 1fr; }
  .article-sidebar { display: none; }
  .mobile-toc { display: block; }
}
@media (max-width: 600px) {
  .article-detail { padding: 20px 16px; }
  .article-header h1 { font-size: 23px; }
  .adjacent-posts { grid-template-columns: 1fr; }
}
</style>
