---
import BlogLayout from "../../layouts/BlogLayout.astro";
import PostFeed from "../../components/posts/PostFeed.vue";
import { getPosts, summarize } from "../../lib/posts";
const posts = (await getPosts()).map(summarize);
---
<BlogLayout title="Artigos" heroTitle="Todas as Publicações" heroSubtitle="Artigos sobre tecnologia, ideias criativas e aprendizados para o seu dia a dia.">
  <PostFeed posts={posts} archive client:load />
</BlogLayout>