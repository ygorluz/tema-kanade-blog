---
import { withBase } from "../lib/urls";
import { siteInfo } from "../config";
import "../styles/global.css";
import Navigation from "../components/header/Navigation.vue";
import Welcome from "../components/header/Welcome.astro";
import Search from "../components/header/Search.vue";
import MainContainer from "../components/MainContainer.vue";
import { getPosts, summarize } from "../lib/posts";

interface Props { title?: string; description?: string; heroTitle?: string; heroSubtitle?: string; home?: boolean; article?: boolean }
const { title, description = siteInfo.description, heroTitle, heroSubtitle, home = false, article = false } = Astro.props;
const posts = (await getPosts()).map(summarize);
const pageTitle = title ? `${title} · ${siteInfo.title}` : `${siteInfo.title} · Artigos, Ideias e Inspiração`;
const canonical = new URL(Astro.url.pathname, siteInfo.url);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="keywords" content={siteInfo.keywords.join(", ")} />
    <meta name="theme-color" content="#fff1f1" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase("/preview.png"), siteInfo.url)} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${siteInfo.title} RSS`} href={withBase("/rss.xml")} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem("theme"); } catch {}
        document.documentElement.classList.toggle("dark", theme === "dark" || (theme !== "light" && matchMedia("(prefers-color-scheme: dark)").matches));
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Pular para o conteúdo principal</a>
    <Navigation pathname={Astro.url.pathname} client:load />
    <Search posts={posts} client:load />
    <Welcome compact={!home} title={heroTitle} subtitle={heroSubtitle} />
    <MainContainer>
      <main id="main-content" tabindex="-1"><slot /></main>
    </MainContainer>
    <footer class="site-footer">
      <a href={withBase("/")} class="footer-mark"><span class="accent">✿</span> {siteInfo.title}.</a>
      <p>Aqui, cada história e boa ideia tem o seu lugar.</p>
      <p>© {new Date().getFullYear()} {siteInfo.author} · Feito com carinho · <a href={withBase("/privacidade/")}>Privacidade</a> · <a href={withBase("/termos/")}>Termos</a> · <a href={withBase("/contato/")}>Contato</a> · <a href={withBase("/rss.xml")}>RSS</a></p>
    </footer>
    <button class="back-top" id="back-top" aria-label="Voltar ao topo" hidden><span class="icon-[lucide--arrow-up]"></span></button>
    <script>
      const button = document.querySelector<HTMLButtonElement>("#back-top");
      const update = () => { if (button) button.hidden = window.scrollY < 500; };
      window.addEventListener("scroll", update, { passive: true });
      button?.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth" });
      });
    </script>
  </body>
</html>
<style>
.site-footer { text-align: center; padding: 42px 20px 50px; color: var(--muted); font-size: 12px; }
.footer-mark { display: inline-flex; align-items: center; gap: 7px; font: 600 21px "Oxanium-Medium", sans-serif; color: var(--text); margin-bottom: 9px; }
.site-footer p { margin: 6px 0; }
.site-footer a { color: var(--text); }
.site-footer a:hover { color: var(--accent); }
.back-top { position: fixed; right: 28px; bottom: 30px; z-index: 30; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line); background: var(--card); color: var(--accent); display: grid; place-items: center; font-size: 19px; box-shadow: 0 4px 18px #00000012; transition: transform .2s; }
.back-top:hover { transform: translateY(-4px); }
</style>