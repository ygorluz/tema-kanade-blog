---
import { withBase } from "../../lib/urls";
import PersonalCard from "./PersonalCard.vue";
import { getCategories, getTags, type PostSummary } from "../../lib/posts";
interface Props { posts: PostSummary[] }
const { posts } = Astro.props;
const tags = getTags(posts);
const categories = getCategories(posts);

const categoryIcons = [
  "icon-[lucide--code-xml]",
  "icon-[lucide--sparkles]",
  "icon-[lucide--palette]",
  "icon-[lucide--coffee]",
  "icon-[lucide--notebook-pen]"
];
---
<aside class="left-sidebar" aria-label="Informações do autor e categorias">
  <PersonalCard posts={posts} />

  <section class="card panel category-panel">
    <h2 class="panel-title"><span class="icon-[lucide--folder-open]" aria-hidden="true"></span>Categorias</h2>
    {categories.map((category, index) => (
      <a href={withBase(`/posts/?category=${encodeURIComponent(category)}`)}>
        <span>
          <span class={categoryIcons[index % categoryIcons.length]} aria-hidden="true"></span>
          {category}
        </span>
        <span class="category-count">{posts.filter(post => post.category === category).length.toString().padStart(2, "0")}</span>
      </a>
    ))}
  </section>

  <section class="card panel" id="tags">
    <h2 class="panel-title"><span class="icon-[lucide--tags]" aria-hidden="true"></span>Tags em Destaque</h2>
    <div class="tag-cloud">
      {tags.map(tag => (
        <a class="chip" href={withBase(`/posts/?tag=${encodeURIComponent(tag)}`)}>{tag}</a>
      ))}
    </div>
  </section>

  <a class="rss-card card" href={withBase("/rss.xml")}>
    <span class="icon-[lucide--rss]" aria-hidden="true"></span>
    <div>
      <strong>Assinar via RSS</strong>
      <p>Receba novos artigos no seu leitor preferido</p>
    </div>
    <span class="icon-[lucide--arrow-up-right]" aria-hidden="true"></span>
  </a>
</aside>

<style>
.category-panel > a { display: flex; align-items: center; justify-content: space-between; font-size: 12px; padding: 8px 0; }
.category-panel > a > span:first-child { display: flex; align-items: center; gap: 9px; }
.category-panel > a > span:first-child > span { font-size: 14px; color: var(--muted); }
.category-panel > a:hover { color: var(--accent); padding-left: 4px; }
.category-count { font: 10px "Oxanium-Medium", sans-serif; color: var(--muted); background: var(--bg); padding: 2px 7px; border-radius: 5px; }
.tag-cloud { display: flex; flex-wrap: wrap; gap: 8px 6px; }
.tag-cloud .chip { font-size: 10px; padding: 3px 8px; border-radius: 6px; }
.tag-cloud .chip:nth-child(3n + 1) { color: #b76f85; background: #fbe4e5; }
.tag-cloud .chip:nth-child(3n + 2) { color: #588f7a; background: #e2efe7; }
.tag-cloud .chip:nth-child(3n + 3) { color: #8283b5; background: #e5e6fa; }
:global(.dark) .tag-cloud .chip:nth-child(3n + 1) { color: #f5b0c2; background: #3d2a32; }
:global(.dark) .tag-cloud .chip:nth-child(3n + 2) { color: #a9cdbd; background: #2c3e39; }
:global(.dark) .tag-cloud .chip:nth-child(3n + 3) { color: #c0b1e0; background: #363046; }
.rss-card { display: flex; align-items: center; gap: 10px; padding: 18px; color: var(--accent); }
.rss-card > span:first-child { font-size: 22px; }
.rss-card div { flex: 1; }
.rss-card strong { font-weight: 500; font-size: 12px; }
.rss-card p { margin: 4px 0 0; font-size: 9px; color: var(--muted); }
</style>
